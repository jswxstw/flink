  {
    "namespace": "com.tencent.subscribe.avro",
    "type": "record",
    "name": "Record",
    "fields": [
      {
        "name": "id",
        "type": "long",
        "doc": "unique id of this record in the whole stream"
      },
      {
        "name": "version",
        "type": "int",
        "doc": "protocol version"
      },
      {
        "name": "messageType",
        "aliases": [
          "operation"
        ],
        "type": {
          "namespace": "com.tencent.subscribe.avro",
          "name": "MessageType",
          "type": "enum",
          "symbols": [
            "INSERT",
            "UPDATE",
            "DELETE",
            "DDL",
            "BEGIN",
            "COMMIT",
            "HEARTBEAT",
            "CHECKPOINT",
            "ROLLBACK",
            "STATEMENT",
            "INIT_DDL",
            "INIT_INSERT"
          ]
        }
      },
      {
        "name": "fileName",
        "type": "string",
        "doc": "binlog file name"
      },
      {
        "name": "timestamp",
        "aliases": [
          "sourceTimestamp"
        ],
        "type": "long",
        "doc": "record log timestamp"
      },
      {
        "name": "gtid",
        "type": "string"
      },
      {
        "name": "position",
        "aliases": [
          "sourcePosition"
        ],
        "type": "string",
        "doc": "end_log_pos of last event (exclude commit) in transaction"
      },
      {
        "name": "safePosition",
        "aliases": [
          "safeSourcePosition"
        ],
        "type": "string",
        "default": "",
        "doc": "end_log_pos of begin event in transaction"
      },
      {
        "name": "transactionId",
        "aliases": [
          "sourceTxid"
        ],
        "type": "string",
        "default": "",
        "doc": "transaction id"
      },
      {
        "name": "serverId",
        "type": "string"
      },
      {
        "name": "threadId",
        "type": "string"
      },
      {
        "name": "sourceType",
        "aliases": [
          "source.sourceType"
        ],
        "type": "string",
        "doc": "source database type"
      },
      {
        "name": "sourceVersion",
        "aliases": [
          "source.version"
        ],
        "type": "string",
        "doc": "source database version"
      },
      {
        "name": "schemaName",
        "type": "string",
        "doc": "name of source schema if exist"
      },
      {
        "name": "tableName",
        "type": "string",
        "doc": "name of source table if exist"
      },
      {
        "name": "objectName",
        "type": "string",
        "doc": "schemaName.tableName",
        "default": ""
      },
      {
        "name": "columns",
        "aliases": [
          "fields"
        ],
        "default": null,
        "type": [
          "null",
          {
            "type": "array",
            "items": "com.tencent.subscribe.avro.Field"
          }
        ]
      },
      {
        "name": "oldColumns",
        "aliases": [
          "beforeImages"
        ],
        "default": null,
        "doc": "values of a row before modify. if values' size is over 20M, they will be discarded",
        "type": [
          "null",
          "bytes",
          {
            "type": "array",
            "items": [
              "null",
              "com.tencent.subscribe.avro.Integer",
              "com.tencent.subscribe.avro.Character",
              "com.tencent.subscribe.avro.Decimal",
              "com.tencent.subscribe.avro.Float",
              "com.tencent.subscribe.avro.Timestamp",
              "com.tencent.subscribe.avro.DateTime",
              "com.tencent.subscribe.avro.TimestampWithTimeZone",
              "com.tencent.subscribe.avro.BinaryGeometry",
              "com.tencent.subscribe.avro.TextGeometry",
              "com.tencent.subscribe.avro.BinaryObject",
              "com.tencent.subscribe.avro.TextObject",
              "com.tencent.subscribe.avro.EmptyObject"
            ]
          }
        ]
      },
      {
        "name": "newColumns",
        "aliases": [
          "afterImages"
        ],
        "default": null,
        "doc": "values of a row after modify. if values' size is over 20M, they will be discarded",
        "type": [
          "null",
          "bytes",
          {
            "type": "array",
            "items": [
              "null",
              "com.tencent.subscribe.avro.Integer",
              "com.tencent.subscribe.avro.Character",
              "com.tencent.subscribe.avro.Decimal",
              "com.tencent.subscribe.avro.Float",
              "com.tencent.subscribe.avro.Timestamp",
              "com.tencent.subscribe.avro.DateTime",
              "com.tencent.subscribe.avro.TimestampWithTimeZone",
              "com.tencent.subscribe.avro.BinaryGeometry",
              "com.tencent.subscribe.avro.TextGeometry",
              "com.tencent.subscribe.avro.BinaryObject",
              "com.tencent.subscribe.avro.TextObject",
              "com.tencent.subscribe.avro.EmptyObject"
            ]
          }
        ]
      },
      {
        "name": "sql",
        "type": "string",
        "doc": "ddl sql if this is a ddl event"
      },
      {
        "name": "executionTime",
        "type": "int",
        "doc": "execution time of ddl sql"
      },
      {
        "name": "heartbeatTimestamp",
        "type": "long",
        "doc": "timestamp of heartbeat send by master if this is a heartbeat record"
      },
      {
        "name": "syncedGtid",
        "type": "string"
      },
      {
        "name": "fakeGtid",
        "type": "boolean",
        "doc": "for some database that has no gtid, a fake gtid will be assigned"
      },
      {
        "name": "pkNames",
        "type": {
          "type": "array",
          "items": "string"
        },
        "doc": "primary keys"
      },
      {
        "name": "readerTimestamp",
        "aliases": [
          "readerThroughoutTime"
        ],
        "type": "long",
        "doc": "a millisecond timestamp. Not implemented at current version"
      },
      {
        "name": "tags",
        "default": {},
        "type": {
          "type": "map",
          "values": "string"
        },
        "doc": "tags to identify properties of this record"
      },
      {
        "name": "index",
        "type": "int",
        "default": -1,
        "doc": "Not implemented at current version"
      },
      {
        "name": "total",
        "type": "int",
        "default": -1,
        "doc": "Not implemented at current version"
      }
    ]
  }
]
